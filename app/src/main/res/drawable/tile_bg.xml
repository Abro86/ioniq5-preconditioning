<!-- activated = outlined by TUNE-knob navigation -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="@color/surface_pressed" /><corners android:radius="18dp" /></shape>
    </item>
    <item android:state_activated="true">
        <shape><solid android:color="@color/surface" /><corners android:radius="18dp" />
            <stroke android:width="3dp" android:color="@color/accent" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/surface" /><corners android:radius="18dp" /></shape>
    </item>
</selector>
